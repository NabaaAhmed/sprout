# URL of the deployed Cloudflare Worker that proxies quiz requests to Gemini.
# Copy this file to `.env` and fill in your Worker URL after deploying
# (see cloudflare-worker/README.md). Never put GEMINI_API_KEY in this frontend.
#
# Example:
#   VITE_QUIZ_WORKER_URL=https://sprout-quiz-worker.your-subdomain.workers.dev
VITE_QUIZ_WORKER_URL=
