# URL of the deployed Cloudflare Worker that proxies quiz-generation
# requests to the Gemini API (see cloudflare-worker/README.md for setup).
#
# Copy this file to `.env` and fill in your real Worker URL, e.g.:
#   VITE_QUIZ_WORKER_URL=https://sprout-quiz-worker.your-subdomain.workers.dev
#
# If left unset, the Study Notes quiz feature will show a friendly
# "not configured" warning instead of failing silently.
VITE_QUIZ_WORKER_URL=
